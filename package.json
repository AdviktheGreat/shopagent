{
  "name": "shopagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first personal shopper Chrome extension prototype",
  "scripts": {
    "test": "node --test tests/core.test.js",
    "test:browser": "node tests/browser.test.js",
    "test:stores": "node tests/stores.test.js",
    "check": "node scripts/check.js",
    "preview": "node scripts/preview.js",
    "format": "prettier --write extension scripts tests package.json README.md"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
